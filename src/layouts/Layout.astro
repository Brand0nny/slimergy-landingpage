---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = "Slimergy — Monitoreo y Control Inteligente de Energía para Hogares Mexicanos",
  description = "Sistema IoT de bajo costo con ESP32, sensor PZEM-004T y App móvil React Native. Visualiza tu consumo eléctrico en tiempo real, controla aparatos remotamente y proyecta tu recibo CFE.",
  image = "/assets/img/logo.png"
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString().replace(/\/$/, '') : 'https://slimergy.mx';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const socialImageURL = new URL(image, siteUrl).href;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content="Slimergy, IoT, ESP32, PZEM-004T, CFE DAC, ahorro de energía, domótica, México, React Native, MQTT" />
    <meta name="theme-color" content="#F4F6F8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0D1524" media="(prefers-color-scheme: dark)" />

    <!-- URL Canónica -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Metadatos Open Graph para redes sociales (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Slimergy" />

    <!-- Twitter Cards (X) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    
    <link rel="icon" type="image/png" href="/assets/img/logo.png" />
    <link rel="apple-touch-icon" href="/assets/img/logo.png" />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Lee el tema guardado en localStorage o respeta la preferencia del sistema operativo -->
    <script is:inline>
      (function() {
        const storedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('slimergy-theme') : null;
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="font-sans selection:bg-slimergy-green selection:text-slimergy-green-dark transition-colors duration-300">
    <!-- Enlace accesible de salto para usuarios de teclado (WCAG 2.4.1) -->
    <a href="#top" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2.5 focus:bg-slimergy-green focus:text-slimergy-green-dark focus:font-black focus:rounded-full focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-black">
      Saltar al contenido principal
    </a>
    <slot />

    <script>
      // Observador para animar los elementos cuando entran en pantalla
      document.addEventListener('DOMContentLoaded', () => {
        requestAnimationFrame(() => {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('reveal-visible');
                observer.unobserve(entry.target);
              }
            });
          }, {
            threshold: 0.08,
            rootMargin: '0px 0px -60px 0px'
          });

          document.querySelectorAll('.reveal-init').forEach((el) => {
            observer.observe(el);
          });
        });
      });
    </script>
  </body>
</html>
