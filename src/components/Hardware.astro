---
// Componentes de hardware del sistema IoT
---

<section class="py-12 sm:py-24 md:py-32 bg-white dark:bg-slimergy-app-bg relative overflow-hidden transition-colors duration-200" id="hardware">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-16 reveal-init">
      <h2 class="text-2xl sm:text-4xl md:text-5xl font-black text-slimergy-main dark:text-white tracking-tight mb-4 sm:mb-5">
        Hardware del sistema
      </h2>
      <p class="text-base sm:text-lg text-slimergy-muted dark:text-slimergy-app-muted font-medium">
        Tres componentes asequibles que trabajan en conjunto para un monitoreo y control de nivel profesional.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 sm:gap-8 mb-8 sm:mb-16">
      
      <!-- Microcontrolador ESP32 -->
      <div class="bg-slimergy-bg dark:bg-slimergy-app-card rounded-3xl sm:rounded-[36px] p-6 sm:p-8 border border-slimergy-border dark:border-slimergy-app-border shadow-app dark:shadow-none hover:shadow-app-hover transition-all duration-300 flex flex-col justify-between reveal-init">
        <div>
          <span class="text-xs font-bold text-slimergy-muted dark:text-slimergy-app-muted uppercase tracking-wider block mb-1">Microcontrolador</span>
          <h3 class="text-2xl font-black text-slimergy-main dark:text-white mb-1">ESP32</h3>
          <p class="text-xs sm:text-sm text-slimergy-muted dark:text-slimergy-app-muted font-medium mb-6">Cerebro y comunicador WiFi del sistema</p>

          <ul class="space-y-3 text-xs font-semibold text-slimergy-main dark:text-white mb-8 divide-y divide-slimergy-border dark:divide-slimergy-app-border">
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">Procesador</span>
              <span class="font-bold">Xtensa LX6 240 MHz</span>
            </li>
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">WiFi</span>
              <span class="font-bold">802.11 b/g/n 2.4 GHz</span>
            </li>
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">GPIO</span>
              <span class="font-bold">34 pines programables</span>
            </li>
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">Flash</span>
              <span class="font-bold">4 MB mínimo</span>
            </li>
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">Protocolo</span>
              <span class="font-bold text-slimergy-green-dark dark:text-slimergy-green">MQTT + JSON</span>
            </li>
          </ul>
        </div>

        <div class="bg-white dark:bg-slimergy-app-sub rounded-2xl p-3.5 border border-slimergy-border dark:border-slimergy-app-border flex items-center justify-between">
          <span class="text-xs font-bold text-slimergy-muted dark:text-slimergy-app-muted">Precio aprox.</span>
          <span class="text-base font-black text-slimergy-main dark:text-white">$80 – $150 MXN</span>
        </div>
      </div>

      <!-- Sensor de energía PZEM-004T -->
      <div class="bg-slimergy-bg dark:bg-slimergy-app-card rounded-3xl sm:rounded-[36px] p-6 sm:p-8 border border-slimergy-border dark:border-slimergy-app-border shadow-app dark:shadow-none hover:shadow-app-hover transition-all duration-300 flex flex-col justify-between reveal-init reveal-d1">
        <div>
          <span class="text-xs font-bold text-slimergy-muted dark:text-slimergy-app-muted uppercase tracking-wider block mb-1">Sensor de energía</span>
          <h3 class="text-2xl font-black text-slimergy-main dark:text-white mb-1">PZEM-004T PZKHCT</h3>
          <p class="text-xs sm:text-sm text-slimergy-muted dark:text-slimergy-app-muted font-medium mb-6">Sensor AC de alta precisión con pinza CT</p>

          <ul class="space-y-3 text-xs font-semibold text-slimergy-main dark:text-white mb-8 divide-y divide-slimergy-border dark:divide-slimergy-app-border">
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">Voltaje AC</span>
              <span class="font-bold">80–260 V ±0.5%</span>
            </li>
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">Corriente AC</span>
              <span class="font-bold">0–100 A ±0.5%</span>
            </li>
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">Potencia</span>
              <span class="font-bold">0–23 kW ±0.5%</span>
            </li>
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">Energía</span>
              <span class="font-bold">0–9999.99 kWh</span>
            </li>
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">Interfaz</span>
              <span class="font-bold text-slimergy-green-dark dark:text-slimergy-green">UART Modbus RTU</span>
            </li>
          </ul>
        </div>

        <div class="bg-white dark:bg-slimergy-app-sub rounded-2xl p-3.5 border border-slimergy-border dark:border-slimergy-app-border flex items-center justify-between">
          <span class="text-xs font-bold text-slimergy-muted dark:text-slimergy-app-muted">Precio aprox.</span>
          <span class="text-base font-black text-slimergy-main dark:text-white">$150 – $250 MXN</span>
        </div>
      </div>

      <!-- Módulo Relay de 2 canales -->
      <div class="bg-slimergy-bg dark:bg-slimergy-app-card rounded-3xl sm:rounded-[36px] p-6 sm:p-8 border border-slimergy-border dark:border-slimergy-app-border shadow-app dark:shadow-none hover:shadow-app-hover transition-all duration-300 flex flex-col justify-between reveal-init reveal-d2">
        <div>
          <span class="text-xs font-bold text-slimergy-muted dark:text-slimergy-app-muted uppercase tracking-wider block mb-1">Control</span>
          <h3 class="text-2xl font-black text-slimergy-main dark:text-white mb-1">Relay 5V 2 Canales</h3>
          <p class="text-xs sm:text-sm text-slimergy-muted dark:text-slimergy-app-muted font-medium mb-6">Interruptor inteligente controlado por el ESP32</p>

          <ul class="space-y-3 text-xs font-semibold text-slimergy-main dark:text-white mb-8 divide-y divide-slimergy-border dark:divide-slimergy-app-border">
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">Carga máx.</span>
              <span class="font-bold">10A 250VAC / 10A 30VDC</span>
            </li>
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">Canales</span>
              <span class="font-bold">2 dispositivos independientes</span>
            </li>
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">Optoacoplador</span>
              <span class="font-bold">Sí — protege el ESP32</span>
            </li>
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">GPIO Slimergy</span>
              <span class="font-bold">GPIO26 / GPIO27</span>
            </li>
            <li class="flex justify-between pt-2">
              <span class="text-slimergy-muted dark:text-slimergy-app-muted font-normal">Latencia</span>
              <span class="font-bold text-slimergy-green-dark dark:text-slimergy-green">&lt; 100 ms</span>
            </li>
          </ul>
        </div>

        <div class="bg-white dark:bg-slimergy-app-sub rounded-2xl p-3.5 border border-slimergy-border dark:border-slimergy-app-border flex items-center justify-between">
          <span class="text-xs font-bold text-slimergy-muted dark:text-slimergy-app-muted">Precio aprox.</span>
          <span class="text-base font-black text-slimergy-main dark:text-white">$55 MXN</span>
        </div>
      </div>

    </div>

    <!-- Diagrama de flujo de datos vía MQTT -->
    <div class="bg-slimergy-bg dark:bg-slimergy-app-card rounded-3xl sm:rounded-[36px] p-5 sm:p-10 border border-slimergy-border dark:border-slimergy-app-border shadow-app dark:shadow-none reveal-init mb-8 sm:mb-16">
      <div class="text-center mb-8">
        <h3 class="text-xl sm:text-2xl font-black text-slimergy-main dark:text-white">Flujo de datos MQTT</h3>
        <p class="text-xs sm:text-sm text-slimergy-muted dark:text-slimergy-app-muted font-medium mt-1">Latencia end-to-end ~2 segundos</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 relative">
        <div class="bg-white dark:bg-slimergy-app-sub rounded-2xl p-5 border border-slimergy-border dark:border-slimergy-app-border text-center flex flex-col items-center justify-center">
          <div class="w-10 h-10 rounded-xl bg-slimergy-green-light dark:bg-slimergy-green/15 text-slimergy-green flex items-center justify-center mb-2">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <span class="text-sm font-black text-slimergy-main dark:text-white">PZEM-004T</span>
          <span class="text-xs text-slimergy-muted dark:text-slimergy-app-muted font-medium">Mide AC</span>
          <span class="mt-2 text-[10px] font-mono bg-slimergy-bg dark:bg-slimergy-app-card px-2 py-0.5 rounded text-slimergy-muted dark:text-slimergy-app-muted">UART / Serial</span>
        </div>

        <div class="bg-white dark:bg-slimergy-app-sub rounded-2xl p-5 border border-slimergy-border dark:border-slimergy-app-border text-center flex flex-col items-center justify-center">
          <div class="w-10 h-10 rounded-xl bg-blue-50 dark:bg-blue-950/40 text-slimergy-blue flex items-center justify-center mb-2">
            <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="9" cy="9" r="1.5"/><circle cx="15" cy="9" r="1.5"/><path d="M9 15h6"/></svg>
          </div>
          <span class="text-sm font-black text-slimergy-main dark:text-white">ESP32</span>
          <span class="text-xs text-slimergy-muted dark:text-slimergy-app-muted font-medium">WiFi + JSON</span>
          <span class="mt-2 text-[10px] font-mono bg-slimergy-bg dark:bg-slimergy-app-card px-2 py-0.5 rounded text-slimergy-muted dark:text-slimergy-app-muted">MQTT publish</span>
        </div>

        <div class="bg-white dark:bg-slimergy-app-sub rounded-2xl p-5 border border-slimergy-border dark:border-slimergy-app-border text-center flex flex-col items-center justify-center">
          <div class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center mb-2">
            <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/></svg>
          </div>
          <span class="text-sm font-black text-slimergy-main dark:text-white">HiveMQ</span>
          <span class="text-xs text-slimergy-muted dark:text-slimergy-app-muted font-medium">Broker cloud</span>
          <span class="mt-2 text-[10px] font-mono bg-slimergy-bg dark:bg-slimergy-app-card px-2 py-0.5 rounded text-slimergy-muted dark:text-slimergy-app-muted">&lt; 50ms</span>
        </div>

        <div class="bg-white dark:bg-slimergy-app-sub rounded-2xl p-5 border border-slimergy-border dark:border-slimergy-app-border text-center flex flex-col items-center justify-center">
          <div class="w-10 h-10 rounded-xl bg-slimergy-green-light dark:bg-slimergy-green/15 text-slimergy-green flex items-center justify-center mb-2">
            <svg class="w-5 h-5 stroke-current fill-none stroke-2" viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 18h.01"/></svg>
          </div>
          <span class="text-sm font-black text-slimergy-main dark:text-white">App Slimergy</span>
          <span class="text-xs text-slimergy-muted dark:text-slimergy-app-muted font-medium">iOS & Android</span>
          <span class="mt-2 text-[10px] font-mono bg-slimergy-bg dark:bg-slimergy-app-card px-2 py-0.5 rounded text-slimergy-muted dark:text-slimergy-app-muted">React Native</span>
        </div>
      </div>
    </div>

    <!-- Tópicos MQTT configurados en la plataforma -->
    <div class="bg-slimergy-bg dark:bg-slimergy-app-card rounded-3xl sm:rounded-[36px] p-6 sm:p-10 border border-slimergy-border dark:border-slimergy-app-border shadow-app dark:shadow-none reveal-init">
      <div class="max-w-3xl mx-auto text-center mb-6 sm:mb-8">
        <h3 class="text-xl sm:text-2xl font-black text-slimergy-main dark:text-white">Tópicos Configurados en la Plataforma</h3>
        <p class="text-xs sm:text-sm text-slimergy-muted dark:text-slimergy-app-muted font-medium mt-1">
          Estructura de tópicos implementada en HiveMQ y consumida por la app móvil:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 sm:gap-4">
        
        <div class="bg-white dark:bg-slimergy-app-sub rounded-2xl p-4 border border-slimergy-border/80 dark:border-slimergy-app-border shadow-sm flex flex-col justify-between">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-slimergy-green"></span>
            <span class="text-[11px] font-extrabold uppercase text-slimergy-muted dark:text-slimergy-app-muted">Telemetría Sensor 1</span>
          </div>
          <code class="text-xs font-mono font-bold text-slimergy-main dark:text-white bg-slimergy-pill dark:bg-slimergy-app-card px-2.5 py-1.5 rounded-lg break-all">
            # smartwatt/u1/data
          </code>
        </div>

        <div class="bg-white dark:bg-slimergy-app-sub rounded-2xl p-4 border border-slimergy-border/80 dark:border-slimergy-app-border shadow-sm flex flex-col justify-between">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-slimergy-green"></span>
            <span class="text-[11px] font-extrabold uppercase text-slimergy-muted dark:text-slimergy-app-muted">Telemetría Sensor 2</span>
          </div>
          <code class="text-xs font-mono font-bold text-slimergy-main dark:text-white bg-slimergy-pill dark:bg-slimergy-app-card px-2.5 py-1.5 rounded-lg break-all">
            # smartwatt/u2/data
          </code>
        </div>

        <div class="bg-white dark:bg-slimergy-app-sub rounded-2xl p-4 border border-slimergy-border/80 dark:border-slimergy-app-border shadow-sm flex flex-col justify-between">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-slimergy-green"></span>
            <span class="text-[11px] font-extrabold uppercase text-slimergy-muted dark:text-slimergy-app-muted">Comando de Relay</span>
          </div>
          <code class="text-xs font-mono font-bold text-slimergy-main dark:text-white bg-slimergy-pill dark:bg-slimergy-app-card px-2.5 py-1.5 rounded-lg break-all">
            # smartwatt/u2/relay/cmd
          </code>
        </div>

        <div class="bg-white dark:bg-slimergy-app-sub rounded-2xl p-4 border border-slimergy-border/80 dark:border-slimergy-app-border shadow-sm flex flex-col justify-between">
          <div class="flex items-center gap-2 mb-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
            <span class="text-[11px] font-extrabold uppercase text-slimergy-muted dark:text-slimergy-app-muted">Canal de Alertas</span>
          </div>
          <code class="text-xs font-mono font-bold text-slimergy-main dark:text-white bg-slimergy-pill dark:bg-slimergy-app-card px-2.5 py-1.5 rounded-lg break-all">
            # smartwatt/alerts
          </code>
        </div>

      </div>
    </div>

  </div>
</section>
