<style>
  /* Animación de rotación y traslación para el selector de tema */
  .theme-knob {
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    transform: translateX(0) rotate(0deg);
  }
  :global(html.dark) .theme-knob {
    transform: translateX(32px) rotate(360deg);
    box-shadow: 0 0 12px rgba(0, 223, 109, 0.45);
  }

  .theme-knob-mobile {
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1), background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    transform: translateX(0) rotate(0deg);
  }
  :global(html.dark) .theme-knob-mobile {
    transform: translateX(24px) rotate(360deg);
    box-shadow: 0 0 12px rgba(0, 223, 109, 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-knob,
    .theme-knob-mobile {
      transition: none !important;
    }
  }
</style>

<script>
  const header = document.getElementById('main-nav');
  const mobileBtn = document.getElementById('mobile-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const links = document.querySelectorAll('.mobile-nav-link');

  let isOpen = false;

  function toggleMenu(forceState?: boolean) {
    isOpen = typeof forceState === 'boolean' ? forceState : !isOpen;
    mobileBtn?.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

    if (isOpen) {
      mobileDrawer?.classList.remove('opacity-0', '-translate-y-4', 'pointer-events-none');
      mobileDrawer?.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden', 'rotate-90');
      closeIcon?.classList.add('rotate-0');
      // Bloquear scroll de la página con el menú abierto
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
      // Mantener la barra visible cuando el menú está abierto
      header?.classList.remove('-translate-y-full');
    } else {
      mobileDrawer?.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
      mobileDrawer?.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden', 'rotate-90');
      closeIcon?.classList.remove('rotate-0');
      // Restaurar scroll de la página
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
    }
  }

  // Evitar que el clic en el botón se propague y cierre el menú de inmediato
  mobileBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleMenu();
  });

  // Evitar que los clics dentro del menú lo cierren
  mobileDrawer?.addEventListener('click', (e) => {
    e.stopPropagation();
  });

  links.forEach(link => {
    link.addEventListener('click', () => {
      toggleMenu(false);
    });
  });

  // Cerrar al hacer clic fuera del menú
  document.addEventListener('click', () => {
    if (isOpen) {
      toggleMenu(false);
    }
  });

  // Cerrar con la tecla ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isOpen) {
      toggleMenu(false);
    }
  });

  // Ocultar barra al scrollear hacia abajo y mostrarla al subir
  let lastScrollY = window.scrollY;

  window.addEventListener('scroll', () => {
    // Si el menú móvil está abierto, no ocultar la barra
    if (isOpen) return;

    const currentScrollY = window.scrollY;

    if (currentScrollY > 80) {
      if (currentScrollY > lastScrollY && currentScrollY - lastScrollY > 5) {
        // Bajando: ocultar la barra
        header?.classList.add('-translate-y-full');
      } else if (lastScrollY - currentScrollY > 5) {
        // Subiendo: mostrar la barra
        header?.classList.remove('-translate-y-full');
      }
    } else {
      // Cerca del tope de página: siempre visible
      header?.classList.remove('-translate-y-full');
    }

    lastScrollY = currentScrollY;
  }, { passive: true });

  // Sincronizar etiqueta meta theme-color para navegadores móviles (Safari iOS, Chrome Android)
  function updateThemeColorMeta(isDark: boolean) {
    const metaThemes = document.querySelectorAll('meta[name="theme-color"]');
    metaThemes.forEach(meta => {
      meta.setAttribute('content', isDark ? '#0D1524' : '#F4F6F8');
    });
  }

  // Alternar tema y sincronizar con localStorage
  function toggleTheme() {
    const isDark = document.documentElement.classList.toggle('dark');
    if (typeof localStorage !== 'undefined') {
      localStorage.setItem('slimergy-theme', isDark ? 'dark' : 'light');
    }
    updateThemeColorMeta(isDark);
    window.dispatchEvent(new CustomEvent('theme-changed', { detail: { isDark } }));
  }

  // Escuchar clics en todos los botones de cambio de tema (escritorio, barra móvil, menú móvil)
  document.querySelectorAll('.theme-toggle-btn').forEach(btn => {
    btn.addEventListener('click', toggleTheme);
  });
</script>
