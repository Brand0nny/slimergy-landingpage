---
// Barra de métricas y especificaciones clave del sistema
---

<section class="relative z-10 -mt-6 sm:-mt-10 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="bg-white dark:bg-slimergy-app-card rounded-2xl sm:rounded-[32px] p-4 sm:p-8 lg:p-10 shadow-app dark:shadow-none border border-slimergy-border dark:border-slimergy-app-border reveal-init transition-colors duration-200">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-8 divide-slimergy-border dark:divide-slimergy-app-border">
        
        <div class="flex flex-col items-center text-center px-2 sm:px-4">
          <div class="inline-flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-slimergy-green-light dark:bg-slimergy-green/15 text-slimergy-green-dark dark:text-slimergy-green mb-2.5 sm:mb-3">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="9" stroke-width="2"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
            </svg>
          </div>
          <span class="text-2xl sm:text-4xl font-black text-slimergy-main dark:text-white tracking-tight">±0.5%</span>
          <span class="text-xs sm:text-sm font-bold text-slimergy-muted dark:text-slimergy-app-muted mt-1">Precisión sensor PZEM-004T</span>
          <span class="text-[10px] sm:text-[11px] text-slate-400 dark:text-slate-400 mt-0.5">Medición AC sin cortar cables</span>
        </div>

        <div class="flex flex-col items-center text-center px-2 sm:px-4">
          <div class="inline-flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-slimergy-green-light dark:bg-slimergy-green/15 text-slimergy-green-dark dark:text-slimergy-green mb-2.5 sm:mb-3">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <span class="text-2xl sm:text-4xl font-black text-slimergy-main dark:text-white tracking-tight">2s</span>
          <span class="text-xs sm:text-sm font-bold text-slimergy-muted dark:text-slimergy-app-muted mt-1">Actualización en tiempo real</span>
          <span class="text-[10px] sm:text-[11px] text-slate-400 dark:text-slate-400 mt-0.5">Telemetría vía MQTT HiveMQ</span>
        </div>

        <div class="flex flex-col items-center text-center px-2 sm:px-4">
          <div class="inline-flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-slimergy-green-light dark:bg-slimergy-green/15 text-slimergy-green-dark dark:text-slimergy-green mb-2.5 sm:mb-3">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <span class="text-2xl sm:text-4xl font-black text-slimergy-main dark:text-white tracking-tight">&lt;100ms</span>
          <span class="text-xs sm:text-sm font-bold text-slimergy-muted dark:text-slimergy-app-muted mt-1">Latencia de control remoto</span>
          <span class="text-[10px] sm:text-[11px] text-slate-400 dark:text-slate-400 mt-0.5">El relay responde al instante</span>
        </div>

        <div class="flex flex-col items-center text-center px-2 sm:px-4">
          <div class="inline-flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 rounded-2xl bg-slimergy-green-light dark:bg-slimergy-green/15 text-slimergy-green-dark dark:text-slimergy-green mb-2.5 sm:mb-3">
            <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <rect x="5" y="2" width="14" height="20" rx="2" stroke-width="2"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01" />
            </svg>
          </div>
          <span class="text-2xl sm:text-4xl font-black text-slimergy-main dark:text-white tracking-tight">5</span>
          <span class="text-xs sm:text-sm font-bold text-slimergy-muted dark:text-slimergy-app-muted mt-1">Pantallas en la app móvil</span>
          <span class="text-[10px] sm:text-[11px] text-slate-400 dark:text-slate-400 mt-0.5">React Native + Expo SDK 50</span>
        </div>

      </div>
    </div>
  </div>
</section>
