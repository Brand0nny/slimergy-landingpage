import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import StatsBar from '../components/StatsBar.astro';
import AppShowcase from '../components/AppShowcase.astro';
import RoomsInteractive from '../components/RoomsInteractive.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import Hardware from '../components/Hardware.astro';
